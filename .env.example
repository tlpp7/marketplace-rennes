# Renn'Fripes — example only. Never commit real credentials.
# Runtime environments use Railway service variable references, not this file.
NODE_ENV=development
RF_DEPLOY_ROLE=local
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Disabled until commercial validation and Stripe integration
SEO_PUBLIC=false
ORDERS_ENABLED=false
ACCOUNTS_ENABLED=false
ALLOW_UNVERIFIED_LOCAL=false

# Database / sessions
DATABASE_URL=postgresql://rennfripes:CHANGER@127.0.0.1:5432/rennfripes
PGSSL=false
PGPOOL_MAX=5
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_32_CARACTERES_OU_PLUS

# Transactional email; required for live registration
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Consignment operator; real legal identity required before taking deposits
CONSIGNMENT_OPERATOR_NAME=
CONSIGNMENT_OPERATOR_ADDRESS=
CONSIGNMENT_OPERATOR_SIRET=
CONSIGNMENT_TERMS_VERSION=
CONSIGNMENT_TERMS_TEXT=
CONSIGNMENT_MEDIA_HOSTS=

# Storage: supply all five variables together, or leave all empty.
# Railway reference values shown in docs/RAILWAY-CONFIG.md.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Private evidence and mandate documents (separate bucket)
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# Payment keys will be configured only after verified Checkout/webhook implementation.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
