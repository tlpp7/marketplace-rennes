{
  "name": "marketplace-rennes",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:products": "node scripts/check-products.mjs",
    "check": "npm run check:products && npm run check:profiles && npm run lint && npm run build",
    "check:profiles": "node scripts/check-profiles.mjs",
    "db:check": "node scripts/check-database.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test scripts/test-unit.mjs",
    "test:v02:production": "node scripts/validate-v02-production.mjs",
    "test:v02:data": "node --test scripts/check-profiles-v02.mjs",
    "test:v02:browser": "playwright test tests/e2e/profiles-v02.spec.mjs --workers=1"
  },
  "dependencies": {
    "next": "^15.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "smtp-server": "^3.13.6",
    "typescript": "^5.0.0"
  }
}
